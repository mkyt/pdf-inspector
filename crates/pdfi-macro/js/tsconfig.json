{
  // `tsc -p crates/pdfi-macro/js` (apps/web: `npm run check:macros`): the
  // bundled macros, the template and the docs' examples against pdfi.d.ts.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "esnext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "types": []
  },
  "files": ["pdfi.d.ts", "template.js"],
  "include": ["../macros/*.js"]
}
